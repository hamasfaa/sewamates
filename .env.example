# Salin ke .env.local. Pakai bot dan proyek terpisah untuk setiap lingkungan.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Pooler Supabase transaction mode (port 6543) untuk runtime Vercel.
# Koneksi direct/session untuk migrasi; kosong = DATABASE_URL.
DIRECT_DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
# Server-only: secret key sb_secret_... atau legacy service_role; bukan publishable/anon.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SewaMatesDevBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ACCOUNT_ENCRYPTION_KEY=
INTERNAL_JOB_SECRET=
# Gunakan nomor HP asli akun yang SUDAH login untuk bootstrap super admin.
SEED_SUPER_ADMIN_PHONE=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
